{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=gameplatform_game;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "your-secret-key-min-32-characters-long-for-security",
    "Issuer": "GamePlatform",
    "Audience": "GamePlatform.Users",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "GameSettings": {
    "MaxPlayersPerSession": 10,
    "SessionTimeoutMinutes": 30,
    "MinPlayersToStart": 2,
    "TickRate": 60
  }
}
